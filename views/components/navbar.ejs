<% navlinks=[ { label: 'Home' , url: '/' }, { label: 'About Us' , url: '/about' }, { label: 'Call For Papers' ,
    url: '/cfp' }, { label: 'Submission' , url: '/submission' }, { label: 'Publications' , url: '/publications' },{ label : "Poster Presentation", url: "/poster" } ,{
      label: "Awards", url: "/awards"
    } ,{ label: 'Invited Speakers' , url: '/speakers' }, {
    label: 'Committee' , url: '/committees' }, { label: 'Registration' , url: '/registration' },
    {
    label: 'Sponsorship' , url: '/sponsorship'
    }
    ,{ label: 'Contact Us' , url: '/contact' } ]; %>



<!-- Container flex only for md and above -->
<div class=" bg-secondary/50 text-secondary-content md:p-4">
  <!-- Container -->
  <div class="flex justify-evenly md:hidden pt-2">
    <span>
      <%- include('logo', { source: '/images/college_logo.png' }) %>
    </span>
    <span>
      <%- include('logo', { source: '/images/nitdel.png' }) %>
    </span>
  </div>

  <div class="flex flex-col md:flex-row md:items-center md:justify-between px-1">

    <!-- Left logo -->
    <div class="hidden md:flex justify-start md:flex-1 ">
      <%- include('logo', { source: '/images/college_logo.png' }) %>
    </div>

    <!-- Name: centered explicitly on md+ -->
    <div class="text-center font-bold text-h3  md:w-2/3 md:mt-0 mt-4 leading-tight flex flex-col items-center ">
      <span class="text-h5 ">ANRF Sponsored</span>
      <img src="/images/anrf.png" alt="ANRF Logo" class="h-16 mb-2 rounded-sm" />
      <span class="text-h5 ">International Conference</span> <span class="text-h6">on</span> Intelligent Computational and Communication Technologies for Sustainable
      Development (ICCT-SD 2026)
      <br>
      <span class="text-h5 font-montserrat">
        1<sup>st</sup> –3<sup>rd</sup> April, 2026
      </span>

      <div class="text-h6 mt-1">
        (Hybrid Mode)
      </div>
    </div>

    <!-- Right logo -->
    <div class="hidden md:flex justify-end md:flex-1">
      <%- include('logo', { source: '/images/nitdel.png' }) %>
    </div>
  </div>

  <!-- Small screen layout adjustment: two logos top row, name bottom row -->

</div>



<div id="navbar" class="flex flex-wrap bg-secondary/50 justify-center gap-2 pt-6 pb-2  ">
  <% for( let index=0; index < navlinks.length; index++ ) { %>
  <%- include('navlink', { label: navlinks[index].label, url: navlinks[index].url }) %>
  <% } %>

</div>