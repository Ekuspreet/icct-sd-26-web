<%
// Submission Content
submission_content = [
  "ICCT-SD-26 invites researchers, practitioners, and students worldwide to submit previously unpublished original papers for consideration for presentation at the conference in English."
];
 %>
<%
 // Submission Guidelines
 submission_guidelines = [
  "Double-blind peer review will be applied to every submission.",
  "Each paper is limited to 8-10 pages. All the submitted papers will undergo plagiarism check by Turnitin/iThenticate before undergoing review process. Only papers that are both accepted and presented will be published in the conference proceedings.",
  "Plagiarism should be less than 15%. Otherwise the paper will not be considered for review and rejected directly.",
  "Authors must prepare papers using the prescribed Springer conference template listed below, follow all formatting and writing guidelines, and ensure the manuscript is grammatically correct and language-checked before submission, as non-compliance may lead to rejection by Springer.",
  "Each paper must include an abstract of 200-250 words and 4-5 relevant keywords.",
  "Figures and tables must be original and should not be copied from any previously published work or online source; copied content will result in rejection.",
  "Every table and figure should be properly numbered and cited within the text. All figures must be of high resolution.",
  "All reference numbers must be accurately cited in the manuscript body corresponding to the reference list.",
  "Before submission, authors must ensure that all guidance or placeholder text from the template has been completely removed."
 ];
%>
<%
// Submission Declaration
submission_declaration = "Submitting an article signifies that the work presented has not been previously published (except as an abstract, a published lecture, or an academic thesis), is not currently under review by any other publication, has been approved for submission by all authors and, where applicable, by the relevant institutional authorities, and that, upon acceptance, it will not be published elsewhere in the same form, in English or any other language, whether in print or electronic format, without the written consent of the copyright holder. To ensure adherence to these conditions, the article may be subject to verification using originality or duplication detection software.";
%>

<%
microsoft_crt_submission_rules = [
  "Register on the conference's online submission system i.e. Microsoft CMT.",
  "Paper format should be PDF only.",
  "Remove author names, affiliations, acknowledgements, and self-citations that reveal identity for double-blind review process.",
  "Submit the anonymized PDF file according to the instructions.",
  "Enter the title, abstract, keywords, author details (only in metadata, not in the manuscript)",
  "Choose relevant conference tracks and subjects.",
  "Verify submission completeness and receive confirmation email."
];
%>

<section class="pt-10 mx-auto px-4 md:max-w-2/3">
  <div class="text-center ">
    <%- include('../components/section_title', { text: 'Paper Submission' }) %>
    <p class="text-justify text-body">
      ICCT-SD-26 invites researchers, practitioners, and students worldwide to submit previously unpublished original papers for consideration for presentation at the conference in English.
    </p>
  </div>
</section>


<div class="divider"></div>


<!-- Submission Guidelines Section -->
<section class="py-20 ">
  <div class="container mx-auto px-4 md:max-w-2/3">
    <div class="text-center mb-16">
      <div class="text-center ">
        <%- include('../components/section_title', { text: 'Submission Guidelines' }) %>
      </div>

    </div>

    <div class="grid gap-4  mx-auto">
      <% for(let i = 0; i < submission_guidelines.length; i++) { %>
      <div class="p-4 bg-base-200 rounded-lg border-l-4 border-secondary/30 shadow-sm flex  items-center ">
        <span class="w-8 h-8 bg-secondary/20 rounded-full flex items-center justify-center mr-4 flex-shrink-0 mt-1">
          <span class="text-secondary font-bold text-sm"><%= i + 1 %></span>
        </span>
        <p class="text-body font-medium text-base-content/90 leading-relaxed flex-1 ">
          <%= submission_guidelines[i] %>
        </p>
      </div>
      <% } %>
    </div>
  </div>
</section>

<div class="divider"></div>

<section class="py-10">
  <div class="container mx-auto px-4 md:max-w-2/3">
    <div class="text-center ">
      <div class="text-center ">
        <%- include('../components/section_title', { text: 'Camera Ready Paper' }) %>
      </div>
    </div>
    <a href="/camera_ready_copy.docx" class="w-full">
      <button class="btn btn-secondary btn-lg w-full">
          Click here to download camera ready paper template.
      </button>
    </a>
  </div>
</section>

<div class="divider"></div>


<!-- Declaration Section -->
<section class="py-20 bg-gradient-to-br from-base-200 to-base-100">
  <div class="container mx-auto px-4 md:max-w-2/3">
    <div class="text-center mb-16">
      <div class="text-center ">
        <%- include('../components/section_title', { text: 'Author Declaration' }) %>
      </div>

      <div class="card bg-white border border-secondary/20  mx-auto">
        <div class="card-body p-8">
          <div class="flex items-start mb-6">
            <div>
              <h3 class="font-bold text-secondary text-h4 mb-4 font-montserrat">
                Terms of Submission
              </h3>
              <p class="text-body text-base-content/90 leading-relaxed text-justify ">
                <%= submission_declaration %>
              </p>
            </div>
          </div>
          <div class="alert  mt-6">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-sm font-semibold">Please read the declaration carefully. All submissions will be verified for originality and duplication.</span>
          </div>
        </div>
      </div>
    </div>
    <a href="/submission_portal.html" class="w-full">
      <button class="btn btn-secondary btn-lg w-full">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
        Submit Your Paper
      </button>
    </a>
</section>
