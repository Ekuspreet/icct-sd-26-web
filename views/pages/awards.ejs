<%
// Awards Categories
awards = [
  {
    title: "Best Paper Award",
    color: "from-purple-500/20 to-purple-300/20",
    borderColor: "border-purple-500/40",
    featured: true,
    criteria: [
      "All nominations will be selected during the review process and grouped into a few key areas.",
      "Nominated papers in the same key area will be presented in the same session.",
      "Only full paper submissions which are presented at the conference will be eligible for the best paper award."
    ]
  },
  {
    title: "Best Student Paper Award",
    color: "from-blue-500/20 to-blue-300/20",
    borderColor: "border-blue-500/40",
    featured: false,
    criteria: [
      "The first author of the paper should be a registered university student.",
      "Only full paper submissions which are presented at the conference will be considered."
    ]
  },
  {
    title: "Best Oral Presentation Award",
    color: "from-green-500/20 to-green-300/20",
    borderColor: "border-green-500/40",
    featured: false,
    criteria: [
      "For every session, one best oral presentation will be selected by session chairs.",
      "Selection based on originality, applicability, technical merit, PPT quality, and more."
    ]
  }
]; %>

<!-- Hero Section -->
<section class="pt-10 mx-auto px-4 md:max-w-2/3">
  <div class="text-center ">
    <%- include('../components/section_title', { text: 'Awards and Recognition' }) %>
    <p class="text-center text-body">
      ICCT-SD 2026 recognizes excellence in research and presentation through various award categories. Outstanding contributions to the field of intelligent computational and communication technologies will be honored.
    </p>
  </div>
</section>


<!-- Awards Categories Section -->
<section class="py-20 bg-base-100">
  <div class="container mx-auto px-4 md:max-w-2/3">


    <div class="flex flex-wrap flex-col xl:flex-row gap-8">
      <% for(let i = 0; i < awards.length; i++) { %>
      <div class="card flex-1 bg-gradient-to-br <%= awards[i].color %> border <%= awards[i].borderColor %> shadow-md hover:shadow-2xl transition-all duration-300 <%= awards[i].featured ? 'ring-2 ring-secondary/50' : '' %>">
        <div class="card-body ">
          <!-- Award Header -->
          <div class=" xl:min-h-36 flex items-center justify-center">
            <h3 class="text-h4 font-bold text-secondary font-montserrat text-center mb-2">
              <%= awards[i].title %>
            </h3>

          </div>

          <!-- Criteria List -->
          <div class="space-y-3">
            <h4 class="font-semibold text-secondary text-body uppercase tracking-wide mb-4">Eligibility:</h4>
            <div class="flex flex-col gap-3">
              <% for(let j = 0; j < awards[i].criteria.length; j++) { %>
              <div class="p-3 bg-white/80 rounded-lg border-l-4 <%= awards[i].borderColor %>">
                <div class="flex items-start">
                  <span class="w-5 h-5 bg-secondary/20 rounded-full flex items-center justify-center mr-3 flex-shrink-0 mt-0.5">
                    <svg class="w-3 h-3 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </span>
                  <p class="text-body text-base-content/90 leading-relaxed text-left">
                    <%= awards[i].criteria[j] %>
                  </p>
                </div>
              </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
      <% } %>
    </div>

    <!-- Call to Action Section -->

  </div>
</section>