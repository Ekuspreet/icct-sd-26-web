<div% // Registration page data (adjust values below as needed) registration_intro="To participate in the ICCT-SD-2026, at least one of the authors of each accepted paper must register and pay the applicable fee as specified below. The registration fee includes a conference kit (for offline participants only), access to all technical sessions, workshops, plenary talks, as well as refreshment / meals. Certificates will be issued to all registered participants." ; publication_note="Only papers that are both accepted and presented will be published in the conference proceedings. Each paper is limited to 8-10 pages." ; student_note="Students and research scholars are required to submit a scanned copy of their institutional ID card along with the registration form. The original ID card must be presented at the time of paper presentation." ; fees=[ { category: 'Research Scholar / Students' , price: '₹ 5500/-' , icon: '🎓' }, { category: 'Academician / Faculty' , price: '₹ 7500/-' , icon: '👨‍🏫' }, { category: 'Delegates from Industry' , price: '₹ 10000/-' , icon: '💼' }, { category: 'Attendees / Participants (Without Paper Presentation)' , price: '₹ 3500/-' , icon: '👥' }, { category : 'Foreign Delegates' , price: '$ 250 (USD)' , icon: '🌍' } ]; registration_links=[ { label: 'Registration Payment Portal' , url: '#' , icon: '💳' }, { label: 'Post-payment Registration Form (Google Form)' , url: '#' , icon: '📝' } ]; %>

  <!-- Hero Section -->
  <section class="pt-10 mx-auto px-4 md:max-w-2/3">
    <div class="text-center">
      <%- include('../components/section_title', { text: 'Registration' }) %>
      <p class="text-justify text-body">
        Register now to secure your spot at ICCT-SD-2026. Join leading researchers, academics, and industry professionals in advancing sustainable development through technology.
      </p>
    </div>
  </section>

  <div class="divider my-20"></div>

  <!-- Main Content -->
  <section class="bg-base-100">
    <div class="container mx-auto px-4 md:max-w-2/3">

      <!-- Section 1: Important Note -->
      <article class="card  border border-secondary/20 shadow-lg hover:shadow-xl transition-shadow duration-300 mb-20">
        <div class="card-body p-8">
          <div class="flex flex-col gap-2 items-center mb-4">
            <div class="text-center ">
              <%- include('../components/section_title', { text: 'Important Information' }) %>
            </div>
          </div>
          <p class="text-body text-base-content/80 mb-4 leading-relaxed"> <%= registration_intro %> </p>

          <div class="p-4 bg-white/80 rounded-lg border-l-4 border-secondary/40 mb-3">
            <p class="text-body text-base-content/80"><strong class="text-secondary">Publication:</strong> <%= publication_note %></p>
          </div>

          <div class="p-4 bg-white/80 rounded-lg border-l-4 border-secondary/40">
            <p class="text-body text-base-content/80"><strong class="text-secondary">Students:</strong> <%= student_note %></p>
          </div>
        </div>
      </article>

      <!-- Section 2: Registration Fees -->
      <article class="card  border border-secondary/20 shadow-lg hover:shadow-xl transition-shadow duration-300 mb-20">
        <div class="card-body p-8">
          <div class="flex flex-col gap-2 items-center mb-4">

            <div class="text-center ">
              <%- include('../components/section_title', { text: 'Registration Fees' }) %>
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-4">
            <% fees.forEach(function(f){ %>
            <div class="p-6 bg-white rounded-lg border-l-4 border-secondary/40 shadow-md hover:shadow-lg transition-shadow duration-300">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <div class="flex items-center mb-2">
                    <span class="text-2xl mr-2"><%= f.icon %></span>
                    <h4 class="text-body text-left font-semibold text-base-content/90"><%= f.category %></h4>
                  </div>
                  <div class="mt-3 pt-3 border-t border-base-300">
                    <p class="text-h4 font-bold text-secondary font-montserrat"><%= f.price %></p>
                  </div>
                </div>
              </div>
            </div>
            <% }) %>
          </div>

        </div>
      </article>

      <!-- Section 3: Registration Links -->
      <article class="card bg-gradient-to-br from-secondary/10 to-primary/10 border border-secondary/30 shadow-xl mb-20">
        <div class="card-body ">
          <div class="flex items-center justify-center mb-4">

            <h3 class="text-h3 font-bold text-secondary font-montserrat">Ready to Register?</h3>
          </div>

          <p class="text-body text-base-content/80 text-center mb-8 leading-relaxed">
            Complete your registration in two simple steps: Make the payment and fill out the registration form.
          </p>

          <div class="flex flex-col  gap-1 p-3 rounded-lg bg-white border-2 border-secondary/30">
            <div class="text-h6 font-semibold text-secondary text-center">Payment Details</div>
            <div class="text-h6 text-center ">
              <span class="text-secondary">Account Information</span>
              <div class="flex flex-col items-center">
                <span>
                  Account Number : 99990000224422
                </span>
                <span>
                  Account Name : CSE-GNDEC
                </span>
                <span>
                  Bank : HDFC Bank Ltd, Miller Ganj, Manju Cinema, Ludhiana
                </span>
                <span>
                  IFSC Code : HDFC0000259
                </span>
              </div>
            </div>
            <div class="divider">OR</div>

            <div class="text-body text-center">
              <span class="text-secondary ">QR Code</span>
              <img src="/images/qr_code.jpeg" alt="QR Code" class="mx-auto w-full h-auto max-w-xs sm:max-w-sm md:max-w-md  object-contain">
            </div>
          </div>

          <div class="flex flex-col  gap-3 p-6 rounded-lg bg-white border-2 border-secondary/30">
            <div class="text-h6 font-semibold text-secondary text-center">Registration Form</div>
            <div class="text-body text-center">
              Please fill the registration form after making the payment. <a href="https://forms.gle/a9jYGkTUYfWzCLMDA" onclick="window.open(this.href, '_blank', 'width=900,height=700'); return false;" rel="noopener noreferrer" class="link link-secondary">Click Here</a> to access the form.
            </div>
          </div>

          <div class="mt-8 p-4 bg-white/80 rounded-lg border-l-4 border-secondary/40">
            <p class="text-body font-semibold text-secondary mb-3">
              <span class="text-error">Important Points:</span>
            </p>
            <ul class="list-disc list-inside text-small text-base-content/70 space-y-2">
              <li>After submitting the registration fee, it is mandatory to complete the registration form. Your registration will be confirmed only after the form is received. Please keep your payment receipt for reference.</li>
              <li>On-campus accommodation will be provided on a first-come-first-serve (FCFS) basis at a nominal rate. If anybody is interested, kindly <a class="link link-secondary" href="/contact.html">contact us</a>.</li>
            </ul>
          </div>
        </div>
      </article>

    </div>
  </section>