<section class="py-10 mx-auto px-4 md:max-w-5xl">
  <div class="text-center mb-10">
    <%- include('../components/section_title', { text: 'Gallery' }) %>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
    <% for (let i = 1; i <= 22; i++) { %>
    <div class="group relative aspect-square rounded-xl overflow-hidden bg-slate-900/40 border border-white/10 backdrop-blur hover:scale-105 hover:z-10 transition-all duration-500 cursor-pointer" onclick="document.getElementById('modal_<%= i %>').showModal()">
      <img src="/images/gallery/<%= i %>.jpeg" alt="Gallery image <%= i %>" class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity" />
      <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity bg-gradient-to-br from-cyan-500/20 via-transparent to-transparent"></div>
    </div>

    <dialog id="modal_<%= i %>" class="modal">
      <div class="modal-box max-w-full w-full h-full max-h-full p-0 bg-black/95">
        <form method="dialog">
          <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2 text-white z-10">✕</button>
        </form>
        <div class="flex items-center justify-center w-full h-full p-4">
          <img src="/images/gallery/<%= i %>.jpeg" alt="Gallery image <%= i %>" class="max-w-full max-h-full object-contain" />
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>
    <% } %>
  </div>
</section>