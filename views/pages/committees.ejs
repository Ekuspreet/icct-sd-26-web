      <div class="text-left text-body flex flex-col gap-6">
        <% for( let i = 0; i < committee.length; i++ ) { %>
        <div>
          <h3 class="text-secondary font-bold text-lg mb-2"><%= committee[i].title %></h3>
          <ul class="flex flex-col gap-2">
            <% for( let j = 0; j < committee[i].members.length; j++ ) { %>
            <li>
              <b><%= committee[i].members[j].name %>,</b> <%= committee[i].members[j].designation %>
            </li>
            <% } %>
          </ul>
        </div>
        <% } %>
      </div>
    </div>
