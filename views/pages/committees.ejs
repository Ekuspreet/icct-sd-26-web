      designation: "Principal, Guru Nanak Dev Engineering College (GNDEC), Ludhiana"
    },
    {
      name: "Prof. (Dr.) Ajay Kumar Sharma",
      designation: "Director, National Institute of Technology (NIT), Delhi"
    }
  ]
},
{
  title: "Advisory Board Chairs",
  members: [
    {
      name: "Prof. (Dr.) Harvinder Singh",
      designation: "Professor and Dean R&D, GNDEC"
    },
    {
      name: "Prof. (Dr.) Geeta Sikka",
      designation: "Professor, Department of Computer Science & Engineering, NIT"
    }
  ]
},
{
  title: "Chairperson",
  members: [
    {
      name: "Prof. (Dr.) Kiran Jyoti",
      designation: "Professor and Head, Department of Computer Science & Engineering, GNDEC"
    }
  ]
},
{
  title: "Convenor",
  members: [
    {
      name: "Dr. Vivek Thapar",
