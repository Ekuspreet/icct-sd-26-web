<section class="pt-10 mx-auto px-4 md:max-w-2/3">
    <div class="text-center mb-12">
        <%- include('../components/section_title', { text: 'Publications' }) %>
        <div class="mt-6 border-2 rounded ">
            <p class="my-4 text-body text-center">
                Selected papers that are
                <span class="font-bold">
                    accepted after peer review and presented at the conference
                </span>
                will be published in a
                <span class="font-bold"> SCOPUS-indexed edited book </span> by
                <span class="font-bold">Taylor & Francis (CRC Press)</span> , in
