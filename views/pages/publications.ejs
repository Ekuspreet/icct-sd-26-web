            </p>
            <div class = "flex flex-col p-2 xl:flex-row ">
                <img
                    src="/images/cmc.png"
                    alt="Taylor & Francis Logo"
                    class="mx-auto mb-4 xl:w-1/3 w-3/4 object-cover  border border-black  "
                />
                <img
                    src="/images/jtie.png"
                    alt="Taylor & Francis Logo"
                    class="mx-auto mb-4 xl:w-1/3 w-3/4 object-cover  border border-black  "
                />
                <img
                    src="/images/qmj.png"
                    alt="Quality Management Journal"
                    class="mx-auto mb-4 xl:w-1/3 w-3/4 object-cover  border border-black  "
                />

            </div>
        </div>
    </div>
</section>
