<!DOCTYPE html>
<html lang="en" data-theme="corporate">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>ICCT-SD 26 | <%= title %>
  </title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/output.css">
</head>

<body class="font-[weight:500] text-justify">
  <div>
    <%- include('components/navbar') %>
  </div>
  <div>

    <%- include('components/waves') %>
  </div>

  <div>
    <%- include(`pages/${page}.ejs`) %>
  </div>

  <!-- Footer -->
  <footer class="footer flex flex-col footer-center bg-gradient-to-br from-secondary to-secondary/70 text-secondary-content p-6 mt-auto">
    <div class="flex items-center justify-center ">
      <%- include('components/logo', { source: '/images/college_logo.png' }) %>
      <%- include('components/logo', { source: '/images/nitdel.png' }) %>
    </div>
    <div>

      <h3 class="text-h2 font-black  font-montserrat">
        ICCT-SD 2026
      </h3>
      <h5 class="text-h6   mt-2">organised by</h5>
